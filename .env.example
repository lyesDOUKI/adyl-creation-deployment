# =============================================================
# Reverse proxy
# =============================================================
HTTP_PORT=80
APP_HOSTNAME=adyl-creation.local
KEYCLOAK_HOSTNAME=auth.adyl-creation.local

# =============================================================
# Images (versions figées, jamais "latest")
# =============================================================
FRONTEND_IMAGE=ghcr.io/lyesdouki/adyl-creation-front:1.0.0
API_IMAGE=ghcr.io/lyesdouki/adyl-creation-api:1.0.0
POSTGRES_VERSION=17.10
KEYCLOAK_VERSION=26.7.2

# =============================================================
# Application
# =============================================================
SERVER_PORT=8084
APP_BASE_URL=https://adyl-creation.local
APP_PHOTOS_STORAGE_PATH=/data/photos

# =============================================================
# Base de données applicative
# =============================================================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=adyl-creation
DB_USERNAME=change-me
DB_PASSWORD=change-me

POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/adyl-creation
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# =============================================================
# Keycloak
# =============================================================
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# =============================================================
# OIDC (Keycloak)
# =============================================================
OIDC_ISSUER_URI=https://${KEYCLOAK_HOSTNAME}/realms/adyl-creation
OIDC_AUTHORIZATION_URL=https://${KEYCLOAK_HOSTNAME}/realms/adyl-creation/protocol/openid-connect/auth
OIDC_TOKEN_URL=https://${KEYCLOAK_HOSTNAME}/realms/adyl-creation/protocol/openid-connect/token
OIDC_AUDIENCE=adyl-creation-api

# =============================================================
# Healthchecks
# =============================================================
POSTGRES_HEALTHCHECK_INTERVAL=10s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=5

KEYCLOAK_DB_HEALTHCHECK_INTERVAL=10s
KEYCLOAK_DB_HEALTHCHECK_TIMEOUT=5s
KEYCLOAK_DB_HEALTHCHECK_RETRIES=5

KEYCLOAK_HEALTHCHECK_INTERVAL=15s
KEYCLOAK_HEALTHCHECK_TIMEOUT=5s
KEYCLOAK_HEALTHCHECK_RETRIES=10
KEYCLOAK_HEALTHCHECK_START_PERIOD=240s

# =============================================================
# Mailing (Brevo SMTP)
# =============================================================
MAILING_ENABLED=true
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=