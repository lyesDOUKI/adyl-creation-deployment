# =========================================================================
# Reverse proxy
# =========================================================================

HTTP_PORT={{ http_port }}

APP_HOSTNAME={{ app_hostname }}

KEYCLOAK_HOSTNAME={{ keycloak_hostname }}


# =========================================================================
# Images
# =========================================================================

FRONTEND_IMAGE={{ frontend_image }}

API_IMAGE={{ api_image }}

POSTGRES_VERSION={{ postgres_version }}

KEYCLOAK_VERSION={{ keycloak_version }}

KEYCLOAK_IMAGE={{ keycloak_image }}


# =========================================================================
# Application
# =========================================================================

SERVER_PORT={{ server_port }}

APP_BASE_URL={{ app_base_url }}

APP_PHOTOS_STORAGE_PATH={{ app_photos_storage_path }}

SPRING_PROFILES_ACTIVE={{ spring_profile }}


# =========================================================================
# Database
# =========================================================================

DB_HOST={{ db_host }}

DB_PORT={{ db_port }}

DB_NAME={{ db_name }}

DB_USERNAME={{ postgres_user }}

DB_PASSWORD={{ postgres_password }}

POSTGRES_USER={{ postgres_user }}

POSTGRES_PASSWORD={{ postgres_password }}

SPRING_DATASOURCE_URL=jdbc:postgresql://{{ db_host }}:{{ db_port }}/{{ db_name }}

SPRING_DATASOURCE_USERNAME={{ postgres_user }}

SPRING_DATASOURCE_PASSWORD={{ postgres_password }}


# =========================================================================
# Keycloak
# =========================================================================

KEYCLOAK_ADMIN_USERNAME={{ keycloak_admin_username }}

KEYCLOAK_ADMIN_PASSWORD={{ keycloak_admin_password }}

KEYCLOAK_DB_NAME={{ keycloak_db_name }}

KEYCLOAK_DB_USER={{ keycloak_db_user }}

KEYCLOAK_DB_PASSWORD={{ keycloak_db_password }}


# =========================================================================
# OIDC
# =========================================================================

OIDC_ISSUER_URI={{ oidc_issuer_uri }}

OIDC_AUTHORIZATION_URL={{ oidc_authorization_url }}

OIDC_TOKEN_URL={{ oidc_token_url }}

OIDC_AUDIENCE={{ oidc_audience }}


# =========================================================================
# Healthchecks
# =========================================================================

POSTGRES_HEALTHCHECK_INTERVAL={{ postgres_healthcheck_interval }}

POSTGRES_HEALTHCHECK_TIMEOUT={{ postgres_healthcheck_timeout }}

POSTGRES_HEALTHCHECK_RETRIES={{ postgres_healthcheck_retries }}

KEYCLOAK_DB_HEALTHCHECK_INTERVAL={{ keycloak_db_healthcheck_interval }}

KEYCLOAK_DB_HEALTHCHECK_TIMEOUT={{ keycloak_db_healthcheck_timeout }}

KEYCLOAK_DB_HEALTHCHECK_RETRIES={{ keycloak_db_healthcheck_retries }}

KEYCLOAK_HEALTHCHECK_INTERVAL={{ keycloak_healthcheck_interval }}

KEYCLOAK_HEALTHCHECK_TIMEOUT={{ keycloak_healthcheck_timeout }}

KEYCLOAK_HEALTHCHECK_RETRIES={{ keycloak_healthcheck_retries }}

KEYCLOAK_HEALTHCHECK_START_PERIOD={{ keycloak_healthcheck_start_period }}


# =========================================================================
# Mailing - Brevo SMTP
# =========================================================================

MAILING_ENABLED={{ mailing_enabled }}

MAIL_HOST={{ mail_host }}

MAIL_PORT={{ mail_port }}

MAIL_USERNAME={{ mail_username }}

MAIL_PASSWORD={{ mail_password }}

MAIL_FROM={{ mail_from }}

ADMIN_EMAIL={{ admin_email }}


# =========================================================================
# Optional Java truststore
# =========================================================================

API_TRUSTSTORE_PASSWORD={{ api_truststore_password }}


# =========================================================================
# Additional application environment variables
# =========================================================================

{% for key, value in application_extra_environment.items() %}
{{ key }}={{ value }}
{% endfor %}


{% if application_env_content | length > 0 %}

# =========================================================================
# Additional environment content supplied by CI
# =========================================================================

{{ application_env_content }}

{% endif %}