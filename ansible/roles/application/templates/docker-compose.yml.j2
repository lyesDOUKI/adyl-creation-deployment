name: adyl-creation

services:

  # =========================================================================
  # Reverse proxy
  # =========================================================================

  reverse-proxy:
    image: nginx:1.27-alpine
    container_name: adyl-creation-proxy
    restart: unless-stopped

    ports:
      - "{{ http_port }}:80"
      - "{{ https_port }}:443"

    volumes:
      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./nginx/.htpasswd:/etc/nginx/.htpasswd:ro
      - {{ certbot_webroot }}:/var/www/certbot:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro

    depends_on:
      frontend:
        condition: service_started

      api:
        condition: service_started

      keycloak:
        condition: service_healthy

      netdata:
        condition: service_started

    networks:
      - proxy


  # =========================================================================
  # Frontend
  # =========================================================================

  frontend:
    image: ${FRONTEND_IMAGE}

    container_name: adyl-creation-front

    restart: unless-stopped

    read_only: true

    environment:
      KEYCLOAK_URL: "{{ keycloak_hostname_url }}"
      KEYCLOAK_REALM: "{{ keycloak_realm }}"
      KEYCLOAK_CLIENT_ID: "adyl-creation-front"

    tmpfs:
      - /var/cache/nginx
      - /var/run
      - /config

    networks:
      - proxy


  # =========================================================================
  # Backend API
  # =========================================================================

  api:
    image: ${API_IMAGE}

    container_name: adyl-creation-api

    restart: unless-stopped

    env_file:
      - .env

    environment:
      SPRING_PROFILES_ACTIVE: ${SPRING_PROFILES_ACTIVE}
      SERVER_PORT: ${SERVER_PORT}

{% if api_truststore_enabled %}
      JAVA_TOOL_OPTIONS: "-Djavax.net.ssl.trustStore=/etc/java/truststore.p12 -Djavax.net.ssl.trustStorePassword=${API_TRUSTSTORE_PASSWORD}"
{% endif %}

    volumes:
      - api_photos:/data/photos

{% if api_truststore_enabled %}
      - ./certificates/java-truststore.p12:/etc/java/truststore.p12:ro
{% endif %}

    depends_on:
      postgres:
        condition: service_healthy

      keycloak:
        condition: service_healthy

    networks:
      - proxy
      - data


  # =========================================================================
  # Application PostgreSQL
  # =========================================================================

  postgres:
    image: postgres:${POSTGRES_VERSION}

    container_name: adyl-creation-postgres

    restart: unless-stopped

    environment:
      POSTGRES_DB: ${DB_NAME}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}

    volumes:
      - postgres_data:/var/lib/postgresql/data

    healthcheck:
      test:
        [
          "CMD",
          "pg_isready",
          "-U",
          "${POSTGRES_USER}",
          "-d",
          "${DB_NAME}"
        ]

      interval: ${POSTGRES_HEALTHCHECK_INTERVAL}
      timeout: ${POSTGRES_HEALTHCHECK_TIMEOUT}
      retries: ${POSTGRES_HEALTHCHECK_RETRIES}

    networks:
      - data


  # =========================================================================
  # Keycloak PostgreSQL
  # =========================================================================

  keycloak-db:
    image: postgres:${POSTGRES_VERSION}

    container_name: adyl-creation-keycloak-db

    restart: unless-stopped

    environment:
      POSTGRES_DB: ${KEYCLOAK_DB_NAME}
      POSTGRES_USER: ${KEYCLOAK_DB_USER}
      POSTGRES_PASSWORD: ${KEYCLOAK_DB_PASSWORD}

    volumes:
      - keycloak_db_data:/var/lib/postgresql/data

    healthcheck:
      test:
        [
          "CMD",
          "pg_isready",
          "-U",
          "${KEYCLOAK_DB_USER}",
          "-d",
          "${KEYCLOAK_DB_NAME}"
        ]

      interval: ${KEYCLOAK_DB_HEALTHCHECK_INTERVAL}
      timeout: ${KEYCLOAK_DB_HEALTHCHECK_TIMEOUT}
      retries: ${KEYCLOAK_DB_HEALTHCHECK_RETRIES}

    networks:
      - data


  # =========================================================================
  # Keycloak
  # =========================================================================

  keycloak:
    image: ${KEYCLOAK_IMAGE}

    container_name: adyl-creation-keycloak

    restart: unless-stopped

    command:
      - start
      - --http-enabled=true
      - --hostname=${KEYCLOAK_HOSTNAME}
      - --hostname-admin=${KEYCLOAK_ADMIN_HOSTNAME}
      - --health-enabled=true
      - --proxy-headers=xforwarded

    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: ${KEYCLOAK_ADMIN_USERNAME}
      KC_BOOTSTRAP_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD}

      KC_DB: postgres
      KC_DB_URL: jdbc:postgresql://keycloak-db:5432/${KEYCLOAK_DB_NAME}
      KC_DB_USERNAME: ${KEYCLOAK_DB_USER}
      KC_DB_PASSWORD: ${KEYCLOAK_DB_PASSWORD}

    depends_on:
      keycloak-db:
        condition: service_healthy

    healthcheck:
      test:
        [
          "CMD",
          "bash",
          "-c",
          "exec 3<>/dev/tcp/127.0.0.1/9000 && echo -e 'GET /health/ready HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3 && grep '200' <&3"
        ]

      interval: ${KEYCLOAK_HEALTHCHECK_INTERVAL}
      timeout: ${KEYCLOAK_HEALTHCHECK_TIMEOUT}
      retries: ${KEYCLOAK_HEALTHCHECK_RETRIES}
      start_period: ${KEYCLOAK_HEALTHCHECK_START_PERIOD}

    networks:
      - proxy
      - data


  # =========================================================================
  # Netdata (monitoring)
  # =========================================================================

  netdata:
    image: netdata/netdata:latest

    container_name: adyl-creation-netdata

    restart: unless-stopped

    hostname: adyl-creation

    cap_add:
      - SYS_PTRACE
      - SYS_ADMIN

    security_opt:
      - apparmor:unconfined

    volumes:
      - netdata_config:/etc/netdata
      - netdata_lib:/var/lib/netdata
      - netdata_cache:/var/cache/netdata
      - /etc/passwd:/host/etc/passwd:ro
      - /etc/group:/host/etc/group:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /etc/os-release:/host/etc/os-release:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro

    # No "ports": reached only through reverse-proxy, on the internal network

    networks:
      - proxy


# ===========================================================================
# Volumes
# ===========================================================================

volumes:

  postgres_data:

  keycloak_db_data:

  api_photos:

  netdata_config:

  netdata_lib:

  netdata_cache:


# ===========================================================================
# Networks
# ===========================================================================

networks:

  proxy:

  data: