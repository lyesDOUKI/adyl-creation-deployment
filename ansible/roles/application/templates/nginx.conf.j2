{% else %}

# =========================================================================
# HTTP - Bootstrap mode
# =========================================================================
# This temporary configuration is used only before the Let's Encrypt
# certificate exists. It lets Certbot validate the domains over HTTP.
# The playbook immediately replaces it with the HTTPS configuration.
# =========================================================================

server {
    listen 80;
    server_name {{ app_hostname }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ {
        proxy_pass http://api:8084;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://frontend:80;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}


server {
    listen 80;
    server_name {{ api_hostname }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
